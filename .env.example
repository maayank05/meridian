# MERIDIAN local configuration. Copy to .env and fill in locally. NEVER commit .env.
MERIDIAN_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=meridian_dev
DB_OWNER_USER=meridian_owner
DB_OWNER_PASSWORD=
DB_READER_USER=meridian_reader
DB_READER_PASSWORD=
TEST_DB_NAME=meridian_test
TEST_DB_USER=meridian_test
TEST_DB_PASSWORD=
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_SIZE=5
OLIST_RAW_DIR=data/raw/olist
SOURCE_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
